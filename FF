<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">

<meta name="viewport"
content="width=device-width,
initial-scale=1,
maximum-scale=1,
user-scalable=no">

<title>FF SETTINGS</title>

<style>

*{
    box-sizing:border-box;
    -webkit-tap-highlight-color:transparent;
}

html,body{
    margin:0;
    padding:0;
    min-height:100%;
}

body{
    background:
    radial-gradient(
        circle at top,
        #451500 0%,
        #0b0b0b 48%
    );

    color:white;
    font-family:Arial,sans-serif;

    padding:22px 12px 40px;
}

.wrap{
    width:100%;
    max-width:560px;
    margin:auto;
}

/* LOGO */

.logo{
    width:88px;
    height:88px;

    margin:0 auto 15px;

    display:flex;
    align-items:center;
    justify-content:center;

    border-radius:50%;

    font-size:42px;

    background:
    linear-gradient(
        135deg,
        #ff1744,
        #ff9800
    );

    border:3px solid #ffeb3b;

    box-shadow:
    0 0 20px #ff1744,
    0 0 45px #ff9800;
}

/* TITLE */

.title{
    text-align:center;

    font-size:33px;

    font-weight:900;

    margin-bottom:5px;

    background:
    linear-gradient(
        90deg,
        #ff9800,
        #ff1744,
        #ffeb3b
    );

    -webkit-background-clip:text;
    -webkit-text-fill-color:transparent;
}

.subtitle{
    text-align:center;

    color:#999;

    margin-bottom:20px;
}

/* BADGE */

.badge{
    display:block;

    width:max-content;
    max-width:100%;

    margin:auto;

    padding:12px 25px;

    border-radius:14px;

    background:
    linear-gradient(
        135deg,
        #720000,
        #ff1744
    );

    border:2px solid #ffeb3b;

    font-size:19px;

    font-weight:900;

    box-shadow:
    0 0 18px #ff1744;
}

/* COUNTER */

.counter{
    text-align:center;

    margin:14px 0 20px;

    color:#ffd180;

    font-weight:bold;
}

/* BOX */

.box{
    background:rgba(24,24,24,.97);

    border:1px solid #383838;

    border-radius:18px;

    padding:20px;

    box-shadow:
    0 10px 35px rgba(0,0,0,.5);
}

/* LABEL */

.label{
    display:block;

    text-align:left;

    margin:3px 0 8px;

    color:#ffd180;

    font-weight:bold;
}

/* SEARCH */

.searchBox{
    position:relative;
}

#phone{
    width:100%;

    padding:16px;

    border-radius:12px;

    border:2px solid #333;

    background:#fff;

    color:#111;

    font-size:16px;

    outline:none;
}

#phone:focus{
    border-color:#ff9800;

    box-shadow:
    0 0 12px
    rgba(255,152,0,.5);
}

/* PHONE LIST */

.phoneList{
    display:none;

    position:absolute;

    left:0;
    right:0;

    top:calc(100% + 6px);

    max-height:230px;

    overflow-y:auto;

    background:#1b1b1b;

    border:1px solid #555;

    border-radius:12px;

    z-index:1000;

    box-shadow:
    0 10px 25px rgba(0,0,0,.7);
}

.phoneItem{
    padding:14px;

    text-align:left;

    border-bottom:1px solid #333;

    color:white;

    cursor:pointer;

    font-weight:bold;
}

.phoneItem:last-child{
    border-bottom:0;
}

.phoneItem:hover,
.phoneItem:active{
    background:
    linear-gradient(
        90deg,
        #ff9800,
        #ff1744
    );
}

.phoneHint{
    text-align:left;

    color:#777;

    font-size:12px;

    margin-top:7px;
}

/* CRITERIA */

.criteria{
    display:grid;

    grid-template-columns:
    1fr 1fr;

    gap:10px;

    margin-top:12px;
}

.criteria button{
    min-height:72px;

    padding:9px;

    border:2px solid #3d3d3d;

    border-radius:13px;

    background:#202020;

    color:white;

    font-size:14px;

    font-weight:900;

    cursor:pointer;

    transition:.15s;
}

.criteria button:active{
    transform:scale(.95);
}

.criteria button.active{
    background:
    linear-gradient(
        135deg,
        #ff9800,
        #ff1744
    );

    border-color:#ffeb3b;

    box-shadow:
    0 0 16px #ff1744;
}

/* PRICE */

.price{
    display:block;

    margin-top:5px;

    color:#ffd740;

    font-size:13px;

    font-weight:900;
}

/* CREATE */

#createBtn{
    width:100%;

    margin-top:18px;

    padding:17px;

    border:0;

    border-radius:13px;

    background:
    linear-gradient(
        90deg,
        #ff9800,
        #ff5722
    );

    color:#111;

    font-size:18px;

    font-weight:900;

    cursor:pointer;

    box-shadow:
    0 5px 18px
    rgba(255,87,34,.35);
}

#createBtn:active{
    transform:scale(.97);
}

/* CLEAR */

#clearBtn{
    width:100%;

    margin-top:9px;

    padding:13px;

    border:1px solid #444;

    border-radius:12px;

    background:#222;

    color:#ccc;

    font-size:15px;

    font-weight:bold;

    cursor:pointer;
}

/* ERROR */

#error{
    display:none;

    margin-top:12px;

    padding:12px;

    border-radius:10px;

    background:#3b1111;

    color:#ff7777;

    font-weight:bold;

    text-align:center;
}

/* RESULT */

#result{
    display:none;

    margin-top:22px;

    padding:20px;

    border:2px solid #ff9800;

    border-radius:16px;

    background:#151515;

    box-shadow:
    0 0 20px rgba(255,152,0,.35);
}

.resultTitle{
    color:#ffeb3b;

    margin-top:0;

    text-align:center;
}

.phoneName{
    color:white;

    text-align:center;

    font-size:18px;

    font-weight:bold;

    word-break:break-word;
}

.presetName{
    color:#ff9800;

    text-align:center;

    font-size:18px;

    font-weight:900;

    margin-top:7px;
}

.priceResult{
    text-align:center;

    color:#ffd740;

    font-weight:900;

    margin:8px 0 20px;
}

/* ROW */

.row{
    font-size:17px;

    font-weight:900;

    margin:10px 0 5px;

    text-align:left;
}

/* BAR */

.bar{
    width:100%;

    height:21px;

    background:#252525;

    border-radius:20px;

    overflow:hidden;

    margin-bottom:13px;
}

.fill{
    height:100%;

    background:
    linear-gradient(
        90deg,
        #ff9800,
        #ff1744,
        #ffeb3b
    );

    border-radius:20px;

    transition:width .5s ease;
}

/* STATUS */

.status{
    margin-top:18px;

    padding:12px;

    border-radius:10px;

    background:#182b18;

    color:#7cff7c;

    font-weight:bold;

    text-align:center;
}

/* FOOTER */

.footer{
    margin-top:22px;

    color:#555;

    font-size:11px;

    text-align:center;
}

@media(max-width:600px){

    .title{
        font-size:28px;
    }

    .logo{
        width:78px;
        height:78px;

        font-size:35px;
    }

    .criteria button{
        font-size:13px;
    }

}

</style>
</head>

<body>

<div class="wrap">

    <div class="logo">
        🎮
    </div>

    <div class="title">
        FREE FIRE SETTINGS
    </div>

    <div class="subtitle">
        Выбери телефон и настройку
    </div>

    <div class="badge">
        ⚡ FF SETTINGS
    </div>

    <div class="counter">
        👥 Создано настроек:
        <span id="count">0</span>
    </div>


    <div class="box">

        <label class="label">
            📱 Поиск модели телефона
        </label>

        <div class="searchBox">

            <input
                id="phone"
                type="text"
                placeholder="Например: OPPO A18"
                autocomplete="off"
            >

            <div
                id="phoneList"
                class="phoneList"
            ></div>

        </div>

        <div class="phoneHint">
            🔎 Начни писать название телефона
        </div>


        <label
            class="label"
            style="margin-top:20px;"
        >
            🎯 Выбери критерий
        </label>


        <div class="criteria">

            <!-- ЧИТ -->

            <button
                type="button"
                data-preset="ЧИТ"
                onclick="selectPreset(this)"
            >
                🔥 ЧИТ

                <span class="price">
                    250 ₸
                </span>
            </button>


            <!-- SOFT -->

            <button
                type="button"
                data-preset="SOFT"
                onclick="selectPreset(this)"
            >
                🎯 SOFT

                <span class="price">
                    350 ₸
                </span>
            </button>


            <!-- FREE -->

            <button
                type="button"
                data-preset="Бесплатный"
                onclick="selectPreset(this)"
            >
                🆓 БЕСПЛАТНЫЙ

                <span class="price">
                    0 ₸
                </span>
            </button>


            <!-- BRAZIL -->

            <button
                type="button"
                data-preset="Бразильский"
                onclick="selectPreset(this)"
            >
                🇧🇷 БРАЗИЛЬСКИЙ

                <span class="price">
                    150 ₸
                </span>
            </button>

        </div>


        <button
            id="createBtn"
            type="button"
            onclick="createSettings()"
        >
            ⚡ СОЗДАТЬ НАСТРОЙКУ
        </button>


        <button
            id="clearBtn"
            type="button"
            onclick="clearAll()"
        >
            🗑️ ОЧИСТИТЬ
        </button>

    </div>


    <div id="error"></div>

    <div id="result"></div>


    <div class="footer">
        FF Settings • Web Preset Generator
    </div>

</div>


<script>

/* =========================
   DATA
========================= */

const phones = [

    /* OPPO */

    "OPPO A18",
    "OPPO A38",
    "OPPO A58",
    "OPPO A60",
    "OPPO A78",
    "OPPO A79",
    "OPPO A98",
    "OPPO Reno 8",
    "OPPO Reno 10",
    "OPPO Reno 11",
    "OPPO Reno 12",
    "OPPO Reno 13",
    "OPPO Find X5",
    "OPPO Find X6",
    "OPPO Find X7",

    /* SAMSUNG */

    "Samsung Galaxy A04",
    "Samsung Galaxy A05",
    "Samsung Galaxy A06",
    "Samsung Galaxy A14",
    "Samsung Galaxy A15",
    "Samsung Galaxy A16",
    "Samsung Galaxy A24",
    "Samsung Galaxy A25",
    "Samsung Galaxy A34",
    "Samsung Galaxy A35",
    "Samsung Galaxy A54",
    "Samsung Galaxy A55",
    "Samsung Galaxy A56",
    "Samsung Galaxy S20",
    "Samsung Galaxy S21",
    "Samsung Galaxy S22",
    "Samsung Galaxy S23",
    "Samsung Galaxy S24",
    "Samsung Galaxy S25",

    /* XIAOMI */

    "Xiaomi Redmi 9",
    "Xiaomi Redmi 10",
    "Xiaomi Redmi 12",
    "Xiaomi Redmi 13",
    "Xiaomi Redmi 14",

    "Redmi Note 10",
    "Redmi Note 11",
    "Redmi Note 12",
    "Redmi Note 13",
    "Redmi Note 14",

    /* POCO */

    "POCO X3",
    "POCO X3 Pro",
    "POCO X4 Pro",
    "POCO X5",
    "POCO X5 Pro",
    "POCO X6",
    "POCO X6 Pro",
    "POCO X7",

    /* REALME */

    "Realme C21",
    "Realme C25",
    "Realme C31",
    "Realme C35",
    "Realme C51",
    "Realme C53",
    "Realme C55",
    "Realme C67",

    "Realme 8",
    "Realme 9",
    "Realme 10",
    "Realme 11",
    "Realme 12",

    /* VIVO */

    "Vivo Y15",
    "Vivo Y21",
    "Vivo Y22",
    "Vivo Y27",
    "Vivo Y36",

    "Vivo V25",
    "Vivo V27",
    "Vivo V29",
    "Vivo V30",

    /* HONOR */

    "Honor X5",
    "Honor X6",
    "Honor X7",
    "Honor X8",
    "Honor X9",
    "Honor X50",
    "Honor 90",
    "Honor 200",

    /* HUAWEI */

    "Huawei P30",
    "Huawei P40",
    "Huawei Nova 9",
    "Huawei Nova 10",
    "Huawei Nova 11",
    "Huawei Nova 12",

    /* INFINIX */

    "Infinix Hot 10",
    "Infinix Hot 11",
    "Infinix Hot 12",
    "Infinix Hot 20",
    "Infinix Hot 30",
    "Infinix Hot 40",
    "Infinix Hot 50",

    "Infinix Note 12",
    "Infinix Note 30",
    "Infinix Note 40",

    /* TECNO */

    "Tecno Spark 8",
    "Tecno Spark 9",
    "Tecno Spark 10",
    "Tecno Spark 20",
    "Tecno Spark 30",

    "Tecno Pova 4",
    "Tecno Pova 5",
    "Tecno Pova 6",

    /* ONEPLUS */

    "OnePlus 8",
    "OnePlus 9",
    "OnePlus 10",
    "OnePlus 11",
    "OnePlus 12",
    "OnePlus Nord",

    /* GOOGLE */

    "Google Pixel 6",
    "Google Pixel 7",
    "Google Pixel 8",
    "Google Pixel 9",

    /* ASUS */

    "ASUS ROG Phone 5",
    "ASUS ROG Phone 6",
    "ASUS ROG Phone 7",
    "ASUS ROG Phone 8",

    /* IPHONE */

    "iPhone 8",
    "iPhone X",
    "iPhone XR",
    "iPhone XS",
    "iPhone 11",
    "iPhone 12",
    "iPhone 13",
    "iPhone 14",
    "iPhone 15",
    "iPhone 16",
    "iPhone 17"

];


/* =========================
   VARIABLES
========================= */

let total = 0;

let selectedPreset = "";


/* =========================
   PRICES
========================= */

const prices = {

    "ЧИТ":250,

    "SOFT":350,

    "Бесплатный":0,

    "Бразильский":150

};


/* =========================
   SEARCH
========================= */

const phoneInput =
    document.getElementById("phone");

const phoneList =
    document.getElementById("phoneList");


function showPhones(){

    const search =
        phoneInput.value
        .trim()
        .toLowerCase();


    phoneList.innerHTML="";


    if(!search){

        phoneList.style.display="none";

        return;

    }


    const filtered =
        phones.filter(function(phone){

            return phone
            .toLowerCase()
            .includes(search);

        });


    if(filtered.length===0){

        phoneList.style.display="none";

        return;

    }


    filtered
    .slice(0,20)
    .forEach(function(phone){

        const item =
            document.createElement("div");

        item.className="phoneItem";

        item.textContent="📱 "+phone;


        item.onclick=function(){

            phoneInput.value=phone;

            phoneList.style.display="none";

        };


        phoneList.appendChild(item);

    });


    phoneList.style.display="block";

}


phoneInput.addEventListener(
    "input",
    showPhones
);


phoneInput.addEventListener(
    "focus",
    function(){

        if(phoneInput.value.trim()){

            showPhones();

        }

    }
);


/* CLOSE SEARCH */

document.addEventListener(
    "click",
    function(event){

        if(
            !event.target.closest(
                ".searchBox"
            )
        ){

            phoneList.style.display="none";

        }

    }
);


/* =========================
   SAFE TEXT
========================= */

function safe(text){

    return String(text).replace(
        /[&<>"']/g,
        function(ch){

            const map={

                "&":"&amp;",

                "<":"&lt;",

                ">":"&gt;",

                '"':"&quot;",

                "'":"&#39;"

            };

            return map[ch];

        }
    );

}


/* =========================
   RANDOM
========================= */

function rnd(min,max){

    return Math.floor(
        Math.random() *
        (max-min+1)
    )+min;

}


/* =========================
   SELECT PRESET
========================= */

function selectPreset(button){

    document
    .querySelectorAll(
        ".criteria button"
    )
    .forEach(function(btn){

        btn.classList.remove(
            "active"
        );

    });


    button.classList.add(
        "active"
    );


    selectedPreset =
        button.getAttribute(
            "data-preset"
        );


    document
    .getElementById("error")
    .style.display="none";

}


/* =========================
   SETTING BAR
========================= */

function makeSetting(
    name,
    value
){

    const percent =
        Math.min(
            100,
            Number(value)/2
        );


    return `

        <div class="row">
            ⚙️ ${name}: ${value}
        </div>

        <div class="bar">

            <div
                class="fill"
                style="
                    width:${percent}%
                "
            ></div>

        </div>

    `;

}


/* =========================
   CREATE SETTINGS
========================= */

function createSettings(){

    const phone =
        phoneInput
        .value
        .trim();


    const error =
        document.getElementById(
            "error"
        );


    const result =
        document.getElementById(
            "result"
        );


    error.style.display="none";


    if(!phone){

        error.innerHTML=
            "📱 Сначала выбери или напиши модель телефона!";

        error.style.display="block";

        phoneInput.focus();

        return;

    }


    if(!selectedPreset){

        error.innerHTML=
            "🎯 Сначала выбери критерий!";

        error.style.display="block";

        return;

    }


    total++;


    document
    .getElementById("count")
    .textContent=total;


    let settings;


    /* ЧИТ */

    if(
        selectedPreset==="ЧИТ"
    ){

        settings={

            "Обзор":rnd(180,200),

            "Колиматор":rnd(180,200),

            "2x":rnd(175,200),

            "4x":rnd(170,200),

            "Снайпер":rnd(160,190),

            "Свободная камера":rnd(80,100),

            "Кнопка":rnd(45,55)

        };

    }


    /* SOFT */

    else if(
        selectedPreset==="SOFT"
    ){

        settings={

            "Обзор":rnd(175,195),

            "Колиматор":rnd(170,195),

            "2x":rnd(165,190),

            "4x":rnd(155,180),

            "Снайпер":rnd(145,175),

            "Свободная камера":rnd(80,100),

            "Кнопка":rnd(42,52)

        };

    }


    /* FREE */

    else if(
        selectedPreset==="Бесплатный"
    ){

        settings={

            "Обзор":rnd(160,180),

            "Колиматор":rnd(150,175),

            "2x":rnd(140,165),

            "4x":rnd(130,155),

            "Снайпер":rnd(120,150),

            "Свободная камера":rnd(80,100),

            "Кнопка":rnd(35,48)

        };

    }


    /* BRAZIL */

    else{

        settings={

            "Обзор":rnd(175,195),

            "Колиматор":rnd(170,195),

            "2x":rnd(160,190),

            "4x":rnd(150,180),

            "Снайпер":rnd(140,170),

            "Свободная камера":rnd(80,100),

            "Кнопка":rnd(42,52)

        };

    }


    const price =
        prices[selectedPreset];


    let html=`

        <h2 class="resultTitle">
            ⚡ НАСТРОЙКА ГОТОВА
        </h2>

        <div class="phoneName">
            📱 ${safe(phone)}
        </div>

        <div class="presetName">
            🎯 ${safe(selectedPreset)}
        </div>

        <div class="priceResult">
            💰 Цена: ${price} ₸
        </div>

        <div class="row">
            🎯 Хедшот:
            ${rnd(85,95)}%
        </div>

    `;


    for(
        const name in settings
    ){

        html += makeSetting(
            name,
            settings[name]
        );

    }


    html+=`

        <div class="status">
            ✅ Пресет создан
        </div>

    `;


    result.innerHTML=html;


    result.style.display="block";


    result.scrollIntoView({

        behavior:"smooth",

        block:"start"

    });

}


/* =========================
   CLEAR
========================= */

function clearAll(){

    phoneInput.value="";

    phoneList.innerHTML="";

    phoneList.style.display="none";


    document
    .getElementById("result")
    .style.display="none";


    document
    .getElementById("error")
    .style.display="none";


    document
    .querySelectorAll(
        ".criteria button"
    )
    .forEach(function(btn){

        btn.classList.remove(
            "active"
        );

    });


    selectedPreset="";

}

</script>

</body>
</html>
